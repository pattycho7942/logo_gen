# 비워두면 자동으로 데모(mock) 모드로 동작합니다.

# OpenAI (ChatGPT) - 프롬프트 보강용
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HuggingFace - text-to-image 생성용
HF_TOKEN=
HF_T2I_MODEL=black-forest-labs/FLUX.1-schnell

# CORS 허용 origin (콤마로 여러 개 지정 가능)
FRONTEND_ORIGINS=http://localhost:5173,https://logo-gen-ten.vercel.app
